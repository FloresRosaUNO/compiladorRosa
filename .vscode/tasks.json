{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc compilar lexer",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/main_test.c",
                "${workspaceFolder}/src/lexer.c",
                "${workspaceFolder}/src/tabla_simbolos.c",
                "-o",
                "${workspaceFolder}/src/main_test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarea generada por el depurador."
        }
    ],
    "version": "2.0.0"
}